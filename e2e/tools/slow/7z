#!/bin/sh
# Stands in for 7-Zip in nzb.spec.ts: writes part of a file where it unpacks to, says how far it
# got, then takes its time until killed.
echo $$ > "$PLEXO_E2E_SLOW_TOOL_PID"
for arg; do case $arg in -o*) out=${arg#-o} ;; esac; done
echo partial > "$out/unpacked.part"
printf ' 12%%'
exec /bin/sleep 600
